# Salesforce External Client App
SF_CLIENT_ID=YOUR_CONSUMER_KEY
SF_CLIENT_SECRET=YOUR_CONSUMER_SECRET

# Use https://test.salesforce.com for a sandbox, or https://login.salesforce.com for a Developer Org.
SF_LOGIN_URL=https://login.salesforce.com

# Must exactly match the External Client App callback URL.
SF_REDIRECT_URI=http://localhost:3000/oauth/callback

# A long random value. Do not commit this file.
SESSION_SECRET=replace-with-a-long-random-secret

PORT=3000
